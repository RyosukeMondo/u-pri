#include <windows.h>
// .NET 2 checks the registered DataLinks DLL version for MDAC >= 2.60.
// This is a forwarding shim, not a Microsoft MDAC binary.
1 VERSIONINFO
FILEVERSION 2,80,9999,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "Upri contributors"
   VALUE "FileDescription", "Experimental Wine ACE IDataInitialize forwarding shim"
   VALUE "FileVersion", "2.80.9999.0"
   VALUE "ProductName", "Upri compatibility experiment"
   VALUE "ProductVersion", "0.1.0.0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
